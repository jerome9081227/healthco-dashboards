# SLO: Patient Vitals Service Availability\n# Target: 99.9% availability over 30-day rolling window\n\nresource \"grafana_slo\" \"patient_vitals_availability\" {\n  name        = \"Patient Vitals Availability\"\n  description = \"Availability SLO for patient vitals ingestion service\"\n\n  objectives {\n    value  = 0.999\n    window = \"30d\"\n  }\n\n  query {\n    type = \"ratio\"\n    ratio {\n      success_metric {\n        prometheus {\n          query = \"sum(rate(vitals_requests_total{status=\\\"success\\\"}[5m]))\"\n        }\n      }\n      total_metric {\n        prometheus {\n          query = \"sum(rate(vitals_requests_total[5m]))\"\n        }\n      }\n    }\n  }\n\n  alerting {\n    fast_burn {\n      annotation {\n        key   = \"summary\"\n        value = \"Patient vitals SLO fast burn alert\"\n      }\n    }\n    slow_burn {\n      annotation {\n        key   = \"summary\"\n        value = \"Patient vitals SLO slow burn alert\"\n      }\n    }\n  }\n}\n